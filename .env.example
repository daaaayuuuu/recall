# Optional overrides. Leave empty for the local YAML fallback and explicit HTTP/Worker addresses below.
GAMEGEN_CONFIG=
PORT=

APP_ENVIRONMENT=development
APP_BASE_URL=http://127.0.0.1:5173
PLAY_BASE_URL=http://127.0.0.1:5173
# all for local/single-host use; Railway API services use app or play.
SERVICE_SURFACE=all
HTTP_ADDRESS=:8080
# Empty in local development. The unified production image sets this to /app/public.
WEB_STATIC_DIR=
# Enable only when every request reaches the process through a trusted reverse proxy.
TRUST_PROXY_HEADERS=false
WORKER_HEALTH_ADDRESS=:8081
WORKER_POLL_INTERVAL=5s
GENERATION_LEASE_DURATION=60s
GENERATION_MAX_EXECUTIONS=3
LOG_LEVEL=debug

# Admin-editable AI settings. The sample key is development-only.
DYNAMIC_AI_CONFIG_ENABLED=true
AI_CONFIG_ENCRYPTION_KEY_V1=AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI=
AI_CONFIG_REFRESH_INTERVAL=2s

# Optional text-to-text AI. An empty key keeps the original love letter.
AI_TEXT_PROVIDER=deepseek
AI_TEXT_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
AI_TEXT_MODEL=deepseek-v4-flash
AI_TEXT_TIMEOUT=30s
AI_TEXT_MAX_OUTPUT_TOKENS=2000

# Optional. Leave the key empty to skip upload moderation without blocking uploads.
AI_IMAGE_MODERATION_PROVIDER=
AI_IMAGE_MODERATION_BASE_URL=
AI_IMAGE_MODERATION_API_KEY=
AI_IMAGE_MODERATION_MODEL=
AI_IMAGE_MODERATION_TIMEOUT=20s
AI_IMAGE_MODERATION_MAX_OUTPUT_TOKENS=300

# Optional. Leave the key empty to reuse the normalized source image and keep creation available.
AI_IMAGE_TO_IMAGE_PROVIDER=
AI_IMAGE_TO_IMAGE_BASE_URL=
AI_IMAGE_TO_IMAGE_API_KEY=
AI_IMAGE_TO_IMAGE_MODEL=
AI_IMAGE_TO_IMAGE_QUALITY=medium
AI_IMAGE_TO_IMAGE_TIMEOUT=3m
AI_IMAGE_TO_IMAGE_MAX_INPUT_BYTES=26214400
AI_IMAGE_TO_IMAGE_MAX_OUTPUT_BYTES=26214400

MYSQL_DSN='gamegen:gamegen_dev_only@tcp(127.0.0.1:3306)/gamegen?parseTime=true&loc=UTC&charset=utf8mb4&multiStatements=true'

MINIO_ENDPOINT=127.0.0.1:9000
# Browser-facing endpoint used only when signing asset URLs. Defaults to MINIO_ENDPOINT when omitted.
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=gamegen
MINIO_SECRET_KEY=gamegen_minio_dev_only
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_PUBLIC_USE_SSL=false

ADMIN_USERNAME=admin
# Generate with: cd backend && go run ./cmd/hash-password 'replace-this-password'
ADMIN_PASSWORD_HASH=replace_with_argon2id_hash
# Development-only sample keys. Replace them outside local development.
CONTENT_ENCRYPTION_KEY_V1=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SHARE_ENCRYPTION_KEY_V1=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
