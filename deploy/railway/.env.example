# Shared by game-gen-app, game-gen-play, and game-gen-worker unless noted.
APP_ENVIRONMENT=production
APP_BASE_URL=https://app.example.com
PLAY_BASE_URL=https://play.example.com
TRUST_PROXY_HEADERS=true
LOG_LEVEL=info
# Used by game-gen-app and game-gen-worker only. Keep the key identical on both services.
DYNAMIC_AI_CONFIG_ENABLED=true
AI_CONFIG_ENCRYPTION_KEY_V1=replace-with-a-third-base64-32-byte-key
AI_CONFIG_REFRESH_INTERVAL=2s

# Optional and used by the private app service only. An empty key keeps the original love letter.
AI_TEXT_PROVIDER=deepseek
AI_TEXT_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
AI_TEXT_MODEL=deepseek-v4-flash
AI_TEXT_TIMEOUT=30s
AI_TEXT_MAX_OUTPUT_TOKENS=2000

# Optional. Leave the key empty to skip upload moderation.
AI_IMAGE_MODERATION_PROVIDER=
AI_IMAGE_MODERATION_BASE_URL=
AI_IMAGE_MODERATION_API_KEY=
AI_IMAGE_MODERATION_MODEL=
AI_IMAGE_MODERATION_TIMEOUT=20s
AI_IMAGE_MODERATION_MAX_OUTPUT_TOKENS=300

# Optional. Leave the key empty to reuse normalized source images.
AI_IMAGE_TO_IMAGE_PROVIDER=
AI_IMAGE_TO_IMAGE_BASE_URL=
AI_IMAGE_TO_IMAGE_API_KEY=
AI_IMAGE_TO_IMAGE_MODEL=
AI_IMAGE_TO_IMAGE_QUALITY=medium
AI_IMAGE_TO_IMAGE_TIMEOUT=3m
AI_IMAGE_TO_IMAGE_MAX_INPUT_BYTES=26214400
AI_IMAGE_TO_IMAGE_MAX_OUTPUT_BYTES=26214400

# Railway private DNS names. Keep MySQL and MinIO service names exactly as documented.
MYSQL_DSN='gamegen:replace-with-mysql-password@tcp(mysql.railway.internal:3306)/gamegen?parseTime=true&loc=UTC&charset=utf8mb4&multiStatements=true'
MINIO_ENDPOINT=minio.railway.internal:9000
MINIO_PUBLIC_ENDPOINT=assets.example.com
MINIO_ACCESS_KEY=gamegen-app
MINIO_SECRET_KEY=replace-with-minio-application-secret
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_PUBLIC_USE_SSL=true

WORKER_POLL_INTERVAL=5s
GENERATION_LEASE_DURATION=60s
GENERATION_MAX_EXECUTIONS=3

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$argon2id$replace-with-generated-hash'
CONTENT_ENCRYPTION_KEY_V1=replace-with-base64-32-byte-key
SHARE_ENCRYPTION_KEY_V1=replace-with-another-base64-32-byte-key
