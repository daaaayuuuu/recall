COMPOSE_PROJECT_NAME=game-gen-prod

# Publish immutable tags or image digests. Do not use latest in production.
GAMEGEN_IMAGE=registry.example.com/game-gen:0.1.0-rc.1

APP_DOMAIN=app.example.com
PLAY_DOMAIN=play.example.com
ASSETS_DOMAIN=assets.example.com
ACME_EMAIL=ops@example.com

MYSQL_DATABASE=gamegen
MYSQL_USER=gamegen
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
# Keep this value consistent with MYSQL_USER, MYSQL_PASSWORD, and MYSQL_DATABASE.
MYSQL_DSN='gamegen:replace-with-a-long-random-password@tcp(mysql:3306)/gamegen?parseTime=true&loc=UTC&charset=utf8mb4&multiStatements=true'

MINIO_ROOT_USER=gamegen-root
MINIO_ROOT_PASSWORD=replace-with-a-long-random-root-secret
MINIO_ACCESS_KEY=gamegen-app
MINIO_SECRET_KEY=replace-with-a-long-random-app-secret
MINIO_REGION=us-east-1

ADMIN_USERNAME=admin
# Generate with: make hash-password PASSWORD='replace-this-password'
ADMIN_PASSWORD_HASH='$argon2id$replace-with-generated-hash'
# Generate each key independently with: openssl rand -base64 32
# Never regenerate these keys after production data has been created.
CONTENT_ENCRYPTION_KEY_V1=replace-with-base64-32-byte-key
SHARE_ENCRYPTION_KEY_V1=replace-with-another-base64-32-byte-key
# Generate independently from the content and share keys.
DYNAMIC_AI_CONFIG_ENABLED=true
AI_CONFIG_ENCRYPTION_KEY_V1=replace-with-a-third-base64-32-byte-key
AI_CONFIG_REFRESH_INTERVAL=2s

LOG_LEVEL=info
WORKER_POLL_INTERVAL=5s
GENERATION_LEASE_DURATION=60s
GENERATION_MAX_EXECUTIONS=3

# Optional text-to-text AI. An empty key keeps the original love letter.
AI_TEXT_PROVIDER=deepseek
AI_TEXT_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
AI_TEXT_MODEL=deepseek-v4-flash
AI_TEXT_TIMEOUT=30s
AI_TEXT_MAX_OUTPUT_TOKENS=2000

# Optional. Leave the key empty to skip moderation without blocking uploads.
AI_IMAGE_MODERATION_PROVIDER=
AI_IMAGE_MODERATION_BASE_URL=
AI_IMAGE_MODERATION_API_KEY=
AI_IMAGE_MODERATION_MODEL=
AI_IMAGE_MODERATION_TIMEOUT=20s
AI_IMAGE_MODERATION_MAX_OUTPUT_TOKENS=300

# Optional. Leave the key empty to reuse the normalized source image.
AI_IMAGE_TO_IMAGE_PROVIDER=
AI_IMAGE_TO_IMAGE_BASE_URL=
AI_IMAGE_TO_IMAGE_API_KEY=
AI_IMAGE_TO_IMAGE_MODEL=
AI_IMAGE_TO_IMAGE_QUALITY=medium
AI_IMAGE_TO_IMAGE_TIMEOUT=3m
AI_IMAGE_TO_IMAGE_MAX_INPUT_BYTES=26214400
AI_IMAGE_TO_IMAGE_MAX_OUTPUT_BYTES=26214400
